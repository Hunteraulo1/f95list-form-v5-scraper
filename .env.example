# API de cache de WillyJL (F95Checker). Valeur par défaut codée, surchargeable.
F95INDEXER_URL=https://api.f95checker.dev

# Contact ajouté au User-Agent, pour que WillyJL puisse nous identifier (URL ou mail)
USER_AGENT_CONTACT=""

# Base du projet principal (MariaDB). Le scraper ne migre rien : le schéma vient de f95list-form-v5.
# En production : un utilisateur limité à SELECT/UPDATE sur game, game_edition, game_translation, origin-website.
DATABASE_URL="mysql://user:password@localhost:3306/f95list_form_dev"

# Serveur HTTP
PORT=3000
# Token attendu en "Authorization: Bearer <token>" sur POST /sync et GET /status
AUTH_TOKEN=

# Concurrence des appels /full (jamais en parallèle pour /fast)
FULL_CONCURRENCY=5

# Logs (JSON sur la sortie standard, format ECS) : champs service.name et service.environment
LOG_LEVEL=info
SERVICE_NAME=f95list-scraper
APP_ENV=dev
